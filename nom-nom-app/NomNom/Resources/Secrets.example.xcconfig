// Secrets template — copy this file to `Secrets.xcconfig` and fill in real values.
// `Secrets.xcconfig` is gitignored; this example file is committed.
//
// IMPORTANT: xcconfig treats `//` as the start of a comment, so the `//` in an
// https URL must be escaped with an empty `$()` variable, exactly as below.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = your-supabase-anon-key
